datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum LessonType {
  VIDEO
  ARTICLE
  PDF
  EXTERNAL_RESOURCE
  LIVE_CLASS
  LIVE_RECORDING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  SSLCOMMERZ
  BKASH
  NAGAD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  logo          String?
  favicon       String?
  description   String?
  email         String
  phone         String?
  address       String?
  website       String?
  primaryColor  String         @default("#4F46E5")
  secondaryColor String        @default("#10B981")
  customDomain  String?        @unique
  isWhiteLabel  Boolean        @default(false)
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  members       OrganizationMember[]
  courses       Course[]
  categories    Category[]
  enrollments   Enrollment[]
  orders        Order[]
  certificates  Certificate[]
  coupons       Coupon[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  passwordHash    String?
  image           String?
  role            Role           @default(STUDENT)
  emailVerified   DateTime?
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberships     OrganizationMember[]
  studentProfile  StudentProfile?
  instructorProfile InstructorProfile?
  enrollments     Enrollment[]
  orders          Order[]
  cart            Cart?
  wishlist        Wishlist[]
  reviews         Review[]
  quizAttempts    QuizAttempt[]
  submissions     AssignmentSubmission[]
  discussions     Discussion[]
  discussionReplies DiscussionReply[]
  notes           Note[]
  certificates    Certificate[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  instructedLiveClasses LiveClass[] @relation("InstructorLiveClasses")
  liveAttendances       LiveClassAttendance[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  headline       String?
  phone          String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  expertise      String
  bio            String
  totalRevenue   Float    @default(0)
  balance        Float    @default(0)
  rating         Float    @default(5.0)
  coursesCount   Int      @default(0)
  studentsCount  Int      @default(0)
  payoutMethod   String?
  payoutDetails  String?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnings       InstructorEarning[]
  withdrawals    Withdrawal[]
}

model Category {
  id             String       @id @default(cuid())
  name           String
  slug           String
  icon           String?
  organizationId String?
  createdAt      DateTime     @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  courses        Course[]
}

model Course {
  id                 String         @id @default(cuid())
  organizationId     String
  instructorId       String
  categoryId         String
  title              String
  slug               String         @unique
  shortDescription   String
  description        String
  thumbnail          String
  previewVideo       String?
  price              Float          @default(0)
  discountPrice      Float?
  level              CourseLevel    @default(ALL_LEVELS)
  language           String         @default("English")
  duration           String?
  totalLessons       Int            @default(0)
  learningOutcomes   String[]
  requirements       String[]
  targetAudience     String[]
  certificateEnabled Boolean        @default(true)
  status             CourseStatus   @default(DRAFT)
  rejectionReason    String?
  rating             Float          @default(5.0)
  studentsCount      Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           Category       @relation(fields: [categoryId], references: [id])
  sections           CourseSection[]
  enrollments        Enrollment[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  reviews            Review[]
  certificates       Certificate[]
  announcements      Announcement[]
  wishlists          Wishlist[]
  liveClasses        LiveClass[]
}

model CourseSection {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quizzes     Quiz[]
  assignments Assignment[]
  liveClasses LiveClass[]
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  title       String
  slug        String
  type        LessonType @default(VIDEO)
  duration    Int        @default(0) // in seconds
  content     String?
  videoUrl    String?
  isFreePreview Boolean   @default(false)
  order       Int        @default(0)
  liveClassId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  liveClass   LiveClass?    @relation(fields: [liveClassId], references: [id], onDelete: SetNull)
  progress    LessonProgress[]
  discussions Discussion[]
  notes       Note[]
  resources   LessonResource[]
}

model LessonResource {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  fileUrl   String
  fileType  String
  size      Int
  createdAt DateTime @default(now())

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  courseId       String
  organizationId String
  orderId        String?
  progress       Float            @default(0)
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?

  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
}

model LessonProgress {
  id                   String   @id @default(cuid())
  studentId            String
  lessonId             String
  watchedSeconds       Int      @default(0)
  completionPercentage Float    @default(0)
  completed            Boolean  @default(false)
  completedAt          DateTime?
  updatedAt            DateTime @updatedAt

  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Quiz {
  id           String        @id @default(cuid())
  sectionId    String
  title        String
  description  String?
  passingScore Int           @default(70)
  timeLimit    Int?          // in minutes
  order        Int           @default(0)
  createdAt    DateTime      @default(now())

  section      CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  question    String
  type        String       @default("MCQ")
  explanation String?
  order       Int          @default(0)

  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     QuizOption[]
  answers     QuizAnswer[]
}

model QuizOption {
  id         String     @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean    @default(false)

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]
}

model QuizAttempt {
  id        String       @id @default(cuid())
  quizId    String
  studentId String
  score     Float
  passed    Boolean
  createdAt DateTime     @default(now())

  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers   QuizAnswer[]
}

model QuizAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  selectedOptionId String?

  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     QuizOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
}

model Assignment {
  id          String                 @id @default(cuid())
  sectionId   String
  title       String
  description String
  instructions String?
  deadline    DateTime?
  totalMarks  Int                    @default(100)
  createdAt   DateTime               @default(now())

  section     CourseSection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  content      String
  fileUrl      String?
  grade        Int?
  feedback     String?
  status       String     @default("PENDING")
  submittedAt  DateTime   @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  studentId String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  student   User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  courseId  String
  addedAt   DateTime @default(now())

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  studentId      String
  organizationId String
  subtotal       Float
  discount       Float         @default(0)
  tax            Float         @default(0)
  total          Float
  currency       String        @default("BDT")
  paymentMethod  PaymentMethod @default(BKASH)
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  enrollments    Enrollment[]
  payments       Payment[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  courseId   String
  price      Float
  discount   Float    @default(0)
  finalPrice Float

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  transactionId  String        @unique
  amount         Float
  currency       String        @default("BDT")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  payload        Json?
  createdAt      DateTime      @default(now())

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Float
  minimumPurchase Float?
  maximumDiscount Float?
  usageLimit      Int?
  usedCount       Int          @default(0)
  startDate       DateTime?
  expiryDate      DateTime?
  organizationId  String?
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  usages          CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  usedAt    DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Review {
  id        String        @id @default(cuid())
  studentId String
  courseId  String
  rating    Int
  comment   String
  createdAt DateTime      @default(now())

  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reply     ReviewReply?

  @@unique([studentId, courseId])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  userId    String
  reply     String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Discussion {
  id        String            @id @default(cuid())
  lessonId  String
  userId    String
  question  String
  createdAt DateTime          @default(now())

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   DiscussionReply[]
}

model DiscussionReply {
  id           String     @id @default(cuid())
  discussionId String
  userId       String
  answer       String
  isInstructor Boolean    @default(false)
  createdAt    DateTime   @default(now())

  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  lessonId  String
  studentId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              String            @id @default(cuid())
  certificateId   String            @unique // e.g. CERT-2026-000128
  studentId       String
  courseId        String
  organizationId  String
  status          CertificateStatus @default(ACTIVE)
  issueDate       DateTime          @default(now())
  qrCodeUrl       String?
  pdfUrl          String?

  student         User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Plan {
  id           String         @id @default(cuid())
  name         String
  price        Float
  billingCycle String         @default("MONTHLY")
  maxCourses   Int
  maxStudents  Int
  maxInstructors Int
  features     String[]

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  billingCycle   String             @default("MONTHLY")
  amount         Float
  currency       String             @default("USD")
  startDate      DateTime           @default(now())
  renewalDate    DateTime
  status         SubscriptionStatus @default(ACTIVE)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
}

model InstructorEarning {
  id                  String   @id @default(cuid())
  instructorProfileId String
  courseId            String
  orderId             String
  saleAmount          Float
  platformCommission  Float
  instructorAmount    Float
  createdAt           DateTime @default(now())

  instructor          InstructorProfile @relation(fields: [instructorProfileId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id                  String           @id @default(cuid())
  instructorProfileId String
  amount              Float
  method              String
  accountDetails      String
  status              WithdrawalStatus @default(PENDING)
  rejectionReason     String?
  requestedAt         DateTime         @default(now())
  processedAt         DateTime?

  instructor          InstructorProfile @relation(fields: [instructorProfileId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String
  organizationId String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  actor          User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

enum LeadStatus {
  CALL_RECEIVED
  CALL_NOT_RECEIVED
  PRICE_PROBLEM
  NEED_DISCOUNT
  NEED_2_3_DAYS
  EXAM_PENDING
  EXAM_COMPLETED
  SEAT_BOOKED
  FULL_ENROLLED
  REJECTED
}

enum AdmissionPaymentType {
  FULL_PAYMENT
  PARTIAL_SEAT_BOOKING
  DUE_CLEARANCE
}

model Batch {
  id                 String       @id @default(cuid())
  name               String
  courseId           String
  startDate          DateTime
  schedule           String
  totalFee           Float        @default(5000)
  scholarshipFee     Float        @default(1500)
  minSeatBookingFee  Float        @default(1000)
  facebookGroupUrl   String?
  totalSeats         Int          @default(50)
  bookedSeats        Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  leads              Lead[]
  submissions        ScholarshipSubmission[]
}

model Lead {
  id                 String       @id @default(cuid())
  name               String
  phone              String
  whatsapp           String
  address            String?
  education          String?
  source             String       @default("WhatsApp Call")
  targetCourse       String?
  batchId            String?
  status             LeadStatus   @default(CALL_RECEIVED)
  excuseOrReason     String?
  notes              String?
  followUpDate       DateTime?
  assignedCounselor  String?
  studentIdCode      String?
  paidAmount         Float        @default(0)
  dueAmount          Float        @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  batch              Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model ScholarshipSubmission {
  id                 String       @id @default(cuid())
  studentIdCode      String       @unique
  name               String
  phone              String
  whatsapp           String
  address            String
  education          String
  score              Int
  totalQuestions     Int          @default(8)
  percentage         Float
  scholarshipWon     Boolean      @default(true)
  totalCourseFee     Float        @default(1500)
  seatBookingFee     Float        @default(300)
  isSeatBooked       Boolean      @default(false)
  isFullPaid         Boolean      @default(false)
  trxId              String?
  paymentMethod      String?
  batchId            String?
  expiresAt          DateTime
  createdAt          DateTime     @default(now())

  batch              Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

enum LiveClassPlatform {
  GOOGLE_MEET
  ZOOM
  MS_TEAMS
  OTHER
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveRecordingStatus {
  NOT_AVAILABLE
  PROCESSING
  AVAILABLE
  PUBLISHED
}

enum EmailDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  RETRYING
}

enum EmailEventType {
  LIVE_CLASS_SCHEDULED
  LIVE_CLASS_UPDATED
  LIVE_CLASS_CANCELLED
  LIVE_CLASS_REMINDER_24H
  LIVE_CLASS_REMINDER_1H
  RECORDING_PUBLISHED
}

model LiveClass {
  id                 String              @id @default(cuid())
  courseId           String
  sectionId          String
  instructorId       String
  title              String
  description        String?
  platform           LiveClassPlatform   @default(ZOOM)
  meetingUrl         String
  meetingId          String?
  meetingPassword    String?
  scheduledDate      DateTime
  startTime          String              // e.g. "20:00" or "8:00 PM"
  endTime            String              // e.g. "21:30" or "9:30 PM"
  timezone           String              @default("Asia/Dhaka")
  status             LiveClassStatus     @default(SCHEDULED)
  recordingStatus    LiveRecordingStatus @default(NOT_AVAILABLE)
  recordingUrl       String?
  recordingDuration  Int?                // duration in seconds
  recordingSize      Int?                // size in bytes
  recordingThumbnail String?
  isPublished        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section            CourseSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  instructor         User                @relation("InstructorLiveClasses", fields: [instructorId], references: [id], onDelete: Cascade)
  lessons            Lesson[]
  attendances        LiveClassAttendance[]
  emailLogs          LiveClassEmailLog[]

  @@index([courseId])
  @@index([sectionId])
  @@index([instructorId])
  @@index([scheduledDate])
  @@index([status])
}

model LiveClassAttendance {
  id                 String              @id @default(cuid())
  liveClassId        String
  studentId          String
  joinedAt           DateTime            @default(now())
  leftAt             DateTime?
  durationSeconds    Int                 @default(0)
  deviceInfo         String?

  liveClass          LiveClass           @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student            User                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@index([liveClassId])
  @@index([studentId])
}

model LiveClassEmailLog {
  id                 String              @id @default(cuid())
  liveClassId        String
  recipientEmail     String
  recipientName      String
  eventType          EmailEventType
  status             EmailDeliveryStatus @default(QUEUED)
  attemptCount       Int                 @default(0)
  errorReason        String?
  sentAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  liveClass          LiveClass           @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@index([liveClassId])
  @@index([status])
  @@index([eventType])
}


